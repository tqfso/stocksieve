# 本文件定义同步和分析后台执行器，完成联调后再安装启用。
[Unit]
Description=StockSieve worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
WorkingDirectory=/zol/work/stocksieve/backend
EnvironmentFile=-/zol/work/stocksieve/backend/.env
Environment=UV_CACHE_DIR=/zol/work/stocksieve/backend/.state/uv-cache
ExecStart=/root/.local/bin/uv run --frozen python run.py worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
