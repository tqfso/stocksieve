# 本文件定义当前服务器的 API 进程，完成联调后再安装启用。
[Unit]
Description=StockSieve API
After=network-online.target docker.service
Wants=network-online.target

[Service]
WorkingDirectory=/zol/work/stocksieve/backend
EnvironmentFile=-/zol/work/stocksieve/backend/.env
Environment=UV_CACHE_DIR=/zol/work/stocksieve/backend/.state/uv-cache
ExecStart=/root/.local/bin/uv run --frozen python run.py api --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
