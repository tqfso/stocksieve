# 本文件列出统一Compose和后端配置；复制到backend/.env，勿提交真实凭据。
# STOCKSIEVE_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/stocksieve
STOCKSIEVE_POSTGRES_USER=stocksieve_admin
STOCKSIEVE_POSTGRES_DB=stocksieve
STOCKSIEVE_POSTGRES_PORT=5432
# 首次部署脚本生成；已有数据库迁移会保留原口令。
STOCKSIEVE_POSTGRES_PASSWORD=
STOCKSIEVE_STATE_DIR=/zol/work/stocksieve/backend/.state
# 当前上线沪深四板块；北交所待免费渠道验收后补充。
STOCKSIEVE_MARKET_BOARDS=SSE_MAIN,SZSE_MAIN,CHINEXT,STAR
STOCKSIEVE_ENABLED_SOURCES=baidu_concepts,baostock
# baidu_concepts仅更新题材、保留原行业；baostock用于基础信息、行业与行情。
STOCKSIEVE_DEFAULT_SOURCE=baostock
STOCKSIEVE_SOURCE_INTERVAL_SECONDS=10
STOCKSIEVE_SOURCE_DAILY_LIMIT=400
# 交易日数量：至少140；上限0表示不限制最新快照窗口，旧快照与报告数据保留。
STOCKSIEVE_HISTORY_TRADING_DAYS=150
STOCKSIEVE_HISTORY_MAX_TRADING_DAYS=0
# 当前阶段默认模拟；接入真实模型时改为 live，并填写下列模型访问配置。
STOCKSIEVE_AI_MODE=mock
STOCKSIEVE_AI_BASE_URL=https://api.openai.com/v1
STOCKSIEVE_AI_MODEL=
STOCKSIEVE_AI_API_KEY=
STOCKSIEVE_AI_PROTOCOL=chat_completions
STOCKSIEVE_AI_TOOLS_SUPPORTED=true
